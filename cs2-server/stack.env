# Vorlage für die CS2-Server-Stacks (ein Stack pro Server, eigener Stackname cs2-1 ... cs2-5)
# Pflicht: SRV_NR, GAME_PORT, TOKEN, RCON_PW – echte Tokens/Passwörter NUR in Portainer eintragen!
#   Server 1: GAME_PORT=27015 · 2: 27016 · 3: 27017 · 4: 27018 · 5: 27019
SRV_NR=1
GAME_PORT=27015
TOKEN=xxx
RCON_PW=xxx

# Optional (Standardwerte stehen im Stack):
# NAME=GROH LAN CS1        (Standard: GROH LAN CS<SRV_NR>)
# TV_PORT=27021            (Standard: 2702<SRV_NR>)
# SERVER_PW=
# MODUS=wingman
# MAP=de_inferno
# SLOTS=5
# BOTS=0
