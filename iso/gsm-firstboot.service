[Unit]
Description=GrohLAN Spielservermanager – Einrichtung beim ersten Start
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
Before=getty@tty1.service
ConditionPathExists=!/var/lib/gsm-installed

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/gsm-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TimeoutStartSec=0
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
